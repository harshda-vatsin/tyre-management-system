PORT=4000
# Loopback-only by default -- Nginx is the public entry point and reverse
# proxies to this port over localhost. Only change if something outside the
# VM legitimately needs to reach the backend directly.
HOST=127.0.0.1
# REQUIRED in production (NODE_ENV=production): the backend refuses to start
# without a unique secret of 32+ characters (`openssl rand -hex 32`). Keep it
# identical across restarts, deployments and instances -- changing it
# invalidates every outstanding access token (users silently re-refresh, but
# in-flight requests will fail once).
JWT_SECRET=change-this-in-production
# Short-lived access token; the HttpOnly refresh cookie keeps users signed in.
ACCESS_TOKEN_EXPIRES_IN=15m
# Refresh session: idle timeout (slides on each refresh) and absolute cap.
REFRESH_TOKEN_IDLE_DAYS=7
REFRESH_TOKEN_MAX_DAYS=30
# The refresh cookie is Secure in production. Nginx is HTTP-only until certbot
# is run; set COOKIE_SECURE=false ONLY until HTTPS is enabled, then remove it.
# COOKIE_SECURE=false

# Postgres connection string. Falls back to a local Docker default
# (postgres:devpassword@localhost:5432/ebtms) if unset -- always set this
# explicitly for anything beyond local dev.
DATABASE_URL=postgres://postgres:devpassword@localhost:5432/ebtms

# FR-AL-01: alert email notifications are only sent when SMTP_HOST is set.
# Leave unset for local/dev use -- alerts still create in-app notifications
# and are logged to the console instead of emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EBTMS Alerts <alerts@ebtms.local>"
